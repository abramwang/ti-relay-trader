# Copy to config/relay.credentials.env, set mode 0600, and fill through a
# secure channel. TEST and PROD encryption keys must be different and must
# exactly match the corresponding OC managed build.
RELAY_CREDENTIAL_ADMIN_TOKEN='replace-with-at-least-32-random-characters'

RELAY_OC_HUAXIN_TEST_CREDENTIAL_KEY_ID='hx-test-YYYYMM'
RELAY_OC_HUAXIN_TEST_CREDENTIAL_KEY_HEX='replace-with-64-hex-characters'

RELAY_OC_HUAXIN_PROD_CREDENTIAL_KEY_ID='hx-prod-YYYYMM'
RELAY_OC_HUAXIN_PROD_CREDENTIAL_KEY_HEX='replace-with-a-different-64-hex-key'
